# GradPrep AI — Voice Service
# Environment variables for the Python Piper TTS service
# Copy to .env and adjust for your environment

# Path to the piper binary (add to PATH or set absolute path)
# On Windows with WSL: PIPER_EXECUTABLE=wsl piper
# After setup_models.ps1: the binary is placed in ./bin/piper.exe
PIPER_EXECUTABLE=piper

# Directory containing downloaded .onnx and .onnx.json model files
MODELS_DIR=./models

# Port the voice service listens on
VOICE_SERVICE_PORT=8001

# CORS origins — comma-separated (use * for local dev, restrict in production)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://localhost:8001

# Optional bearer token to protect synthesis endpoints.
# Set the same value as VITE_VOICE_SERVICE_API_KEY in the frontend .env.
# Leave empty to disable authentication (local dev only).
API_SECRET_KEY=
